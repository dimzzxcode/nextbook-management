# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nextbook

# JWT Secrets (min 32 chars, generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-long

# App
APP_URL=http://localhost:3000

# Seed — Default Admin (opsional, override jika diperlukan)
ADMIN_EMAIL=admin@pustaka.id
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrator

# Upstash Redis (opsional, untuk rate limiting multi-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
